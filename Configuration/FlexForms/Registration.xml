                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim,int</eval>
                            <default>300</default>
                        </config>
                    </settings.confirmationEmail.timeLock>
                    <settings.confirmationEmail.useHTML>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.useHTML
                        </label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.confirmationEmail.useHTML>
                    <settings.confirmationEmail.subject>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.subject
                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.confirmationEmail.subject>
                </el>
            </ROOT>
        </confirmationEmail>
        <welcomeEmail>
            <ROOT>
                <sheetTitle>LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.welcomeEmail</sheetTitle>
