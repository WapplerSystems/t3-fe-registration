                            <default>1</default>
                        </config>
                    </settings.welcomeEmail.useHTML>
                    <settings.welcomeEmail.subject>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.subject
                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.welcomeEmail.subject>
                </el>
            </ROOT>
        </welcomeEmail>
