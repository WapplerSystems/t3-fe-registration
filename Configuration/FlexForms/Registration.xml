<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.main</sheetTitle>
                <type>array</type>
                <el>

                    <settings.formStep1>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:tt_content.pi_flexform.feregistration.step1
                        </label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <label>
                                        LLL:EXT:form/Resources/Private/Language/Database.xlf:tt_content.pi_flexform.formframework.selectPersistenceIdentifier
                                    </label>
                                    <value></value>
                                </numIndex>
                            </items>
                            <softref>formPersistenceIdentifier</softref>
                        </config>
                    </settings.formStep1>

                    <settings.formStep2>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:tt_content.pi_flexform.feregistration.step2
                        </label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <label>
                                        LLL:EXT:form/Resources/Private/Language/Database.xlf:tt_content.pi_flexform.formframework.selectPersistenceIdentifier
                                    </label>
                                    <value></value>
                                </numIndex>
                            </items>
                            <softref>formPersistenceIdentifier</softref>
                        </config>
                    </settings.formStep2>

                    <settings.forward>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.forward
                        </label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                        </config>
                    </settings.forward>


                    <settings.identifierFieldName>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.identifierFieldName
                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.identifierFieldName>

                    <settings.confirmationRequestPid>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.confirmationRequestPid
                        </label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <size>1</size>
                            <suggestOptions>
                                <default>
                                    <addWhere>AND pages.doktype = 254</addWhere>
                                </default>
                            </suggestOptions>
                        </config>
                    </settings.confirmationRequestPid>

                    <settings.feUserStoragePid>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.feUserStoragePid
                        </label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <size>1</size>
                            <suggestOptions>
                                <default>
                                    <addWhere>AND pages.doktype = 254</addWhere>
                                </default>
                            </suggestOptions>
                        </config>
                    </settings.feUserStoragePid>

                    <settings.usergroups>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.usergroups
                        </label>
                        <config>
                            <type>group</type>
                            <allowed>fe_groups</allowed>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                            <size>1</size>
                        </config>
                    </settings.usergroups>

                    <settings.createFeUser>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.createFeUser
                        </label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.createFeUser>
                </el>
            </ROOT>
        </sDEF>
        <confirmationEmail>
            <ROOT>
                <sheetTitle>LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.confirmationEmail</sheetTitle>
                <type>array</type>
                <el>
                    <settings.confirmationEmail.senderEmailAddress>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.senderEmailAddress
                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.confirmationEmail.senderEmailAddress>
                    <settings.confirmationEmail.senderName>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.senderName
                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.confirmationEmail.senderName>
                    <settings.confirmationEmail.timeLock>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.timeLock
                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim,int</eval>
                            <default>300</default>
                        </config>
                    </settings.confirmationEmail.timeLock>
                    <settings.confirmationEmail.useHTML>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.useHTML
                        </label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.confirmationEmail.useHTML>
                    <settings.confirmationEmail.subject>
                        <label>
                            LLL:EXT:fe_registration/Resources/Private/Language/locallang_db.xlf:flexform.subject
                        </label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.confirmationEmail.subject>
                </el>
            </ROOT>
        </confirmationEmail>
    </sheets>
</T3DataStructure>
