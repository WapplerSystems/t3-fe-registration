plugin.tx_feregistration {
  view {
    templateRootPaths.0 = EXT:fe_registration/Resources/Private/Templates
    templateRootPaths.10 = {$plugin.tx_feregistration.view.templateRootPath}
    partialRootPaths.0 = EXT:fe_registration/Resources/Private/Partials
    partialRootPaths.10 = {$plugin.tx_feregistration.view.partialRootPath}
    layoutRootPaths.0 = EXT:fe_registration/Resources/Private/Layouts
    layoutRootPaths.10 = {$plugin.tx_feregistration.view.layoutRootPath}
  }

  settings {

    email {
      layoutRootPaths {
        40 = EXT:fe_registration/Resources/Private/Layouts/
        50 = {$plugin.tx_feregistration.view.layoutRootPath}
      }
      templateRootPaths {
        40 = EXT:fe_registration/Resources/Private/Templates/
        50 = {$plugin.tx_feregistration.view.templateRootPath}
      }
    }

  }
}


formExtendedResend = PAGE
formExtendedResend {
  typeNum = 1735853778

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = none
    admPanel = 0
    debug = 0
    disablePrefixComment = 1
    metaCharset = utf-8
    disableBodyTag = 1
    no_cache = 1
  }

  10 < tt_content.feregistration_resendconfirmationemail.20
  10.settings < plugin.tx_feregistration.settings

}

