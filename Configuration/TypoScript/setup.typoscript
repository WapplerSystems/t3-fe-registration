plugin.tx_feregistration {
  view {
    templateRootPaths.10 = EXT:fe_registration/Resources/Private/Templates
    partialRootPaths.10 = EXT:fe_registration/Resources/Private/Partials
    layoutRootPaths.10 = EXT:fe_registration/Resources/Private/Layouts
  }

  settings {
    feUserStoragePid = {$plugin.tx_feregistration.settings.feUserStoragePid}
    optInStoragePid = {$plugin.tx_feregistration.settings.optInStoragePid}
    createFeUser = {$plugin.tx_feregistration.settings.createFeUser}
    usergroups = {$plugin.tx_feregistration.settings.usergroups}
    validationPid = {$plugin.tx_feregistration.settings.validationPid}
    optInEmail {
      useHTML = {$plugin.tx_feregistration.settings.optInEmail.useHTML}
      senderAddress = {$plugin.tx_feregistration.settings.optInEmail.senderAddress}
      senderName = {$plugin.tx_feregistration.settings.optInEmail.senderName}
      timeLock = {$plugin.tx_feregistration.settings.optInEmail.timeLock}
    }

    templateRootPaths < plugin.tx_feregistration.view.templateRootPaths
    partialRootPaths < plugin.tx_feregistration.view.partialRootPaths
    layoutRootPaths < plugin.tx_feregistration.view.layoutRootPaths
  }
}


formExtendedResend = PAGE
formExtendedResend {
  typeNum = 1735853778

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = none
    admPanel = 0
    debug = 0
    disablePrefixComment = 1
    metaCharset = utf-8
    additionalHeaders.10.header = Content-Type:text/html;charset=UTF-8
    disableBodyTag = 1
    no_cache = 1
  }

  10 < tt_content.formextended_resendoptinemail.20
  10.settings < plugin.tx_feregistration.settings

}
