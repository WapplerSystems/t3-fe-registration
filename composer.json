{
    "name": "wapplersystems/fe-registration",
    "type": "typo3-cms-extension",
    "description": "Frontend user registration for TYPO3 using EXT:form",
    "keywords": [
        "TYPO3",
        "extension",
        "registration",
        "frontend user"
    ],
    "homepage": "https://github.com/WapplerSystems/t3-fe-registration",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "license": "GPL-2.0-or-later",
    "support": {
        "issues": "https://github.com/WapplerSystems/t3-fe-registration/issues",
        "source": "https://github.com/WapplerSystems/t3-fe-registration"
    },
    "require": {
        "typo3/cms-form": "^13.4",
        "wapplersystems/form_extended": "^13"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\FeRegistration\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "fe_registration"
        }
    }
}